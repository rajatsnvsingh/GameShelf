{
  "name": "gameshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:smoke:dev": "npm run build && node scripts/smoke.mjs --dev",
    "test:screenshots:smoke": "npm run build && node scripts/screenshots-smoke.mjs",
    "capture:screenshots": "npm run build && node scripts/smoke.mjs --screenshots",
    "test:database:smoke": "npm run build && node scripts/database-smoke.mjs",
    "test:igdb:live": "node --experimental-strip-types scripts/igdb-live.ts",
    "test:thegamesdb:live": "node --experimental-strip-types scripts/thegamesdb-live.ts",
    "build": "electron-vite build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
