{
  "name": "gameshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:smoke:dev": "npm run build && node scripts/smoke.mjs --dev",
    "build": "electron-vite build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.13.3",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
